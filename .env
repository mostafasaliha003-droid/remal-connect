# المنفذ المحلي
PORT=3000

# مفتاح مورد الـ eSIM (لا علاقة له برمال بوكينجز)
SUPPLIER_API_KEY=your_new_esim_supplier_key

# مفتاح الدفع الجديد (الخاص بـ Remal Connect فقط)
CONNECT_PAYMENT_API_KEY=your_new_payment_gateway_key

# قاعدة بيانات جديدة تماماً ومستقلة
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/remal_connect_independent_db
