# إعدادات الخادم
PORT=3000

# مفتاح الربط الخاص بمورد الـ eSIM (لإصدار الشرائح)
SUPPLIER_API_KEY=ضع_مفتاح_المورد_هنا

# مفتاح الربط الخاص ببوابة الدفع Ziina (لمعالجة المدفوعات)
ZIINA_API_KEY=ضع_مفتاح_زينا_الخاص_ببيئة_الإنتاج_هنا

# رابط الاتصال بقاعدة بيانات MongoDB Atlas (لحفظ بيانات مستخدمي Remal Connect)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/remal_connect
